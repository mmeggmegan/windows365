{
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "**/obj/**",
          "**/includes/**",
          "_themes/**",
          "**/docfx.json",
          "_repo.en-us/**",
          "README.md",
          "LICENSE",
          "LICENSE-CODE",
          "ThirdPartyNotices.md",
          "SECURITY.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/*.gif", 
          "**/*.jpeg", 
          "**/*.jpg", 
          "**/*.png", 
          "**/*.svg"
        ],
        "exclude": [
          "**/obj/**",
          "**/includes/**",
          "_themes/**",
          "**/docfx.json",
          "_repo.en-us/**"
        ]
      }
    ],

    "overwrite": [],
    "externalReference": [],
    "globalMetadata": {
      "brand": "azure",
      "uhfHeaderId": "azure",
      "breadcrumb_path": "/azure/virtual-desktop/breadcrumb/toc.json",
      "feedback_system": "Standard",
      "searchScope": [ "Azure" ],
      "permissioned-type": "public",
      "recommendations": true,
      "recommendation_types": [ "Training", "Certification" ],
      "zone_pivot_group_filename": "virtual-desktop/zone-pivot-groups.json"
    },
    "fileMetadata": {
      "feedback_product_url": {
        "virtual-desktop/**/*": "https://techcommunity.microsoft.com/t5/azure-virtual-desktop/idb-p/AzureVirtualDesktop"
      },
      "author": {
        "virtual-desktop/**/*.md": "eliotgra",
        "virtual-desktop/**/*.yml": "eliotgra"
      },
      "manager": {
        "virtual-desktop/**/*.md": "eliotgra",
        "virtual-desktop/**/*.yml": "eliotgra"
      },
      "ms.author": {
        "virtual-desktop/**/*.md": "eliotgra",
        "virtual-desktop/**/*.yml": "eliotgra"
      },
      "ms.service": {
        "virtual-desktop/**/*.md": "azure-virtual-desktop",
        "virtual-desktop/**/*.yml": "azure-virtual-desktop"
      },
      "titleSuffix": {
        "virtual-desktop/**/*.md": "Azure Virtual Desktop"
      }
    },
    "template": [
      "docs.html",
      "default",
      "DocFx.Plugins.PlantUml/template"
    ]
  }
}
